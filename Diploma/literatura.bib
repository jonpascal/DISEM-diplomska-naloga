@mastersthesis{Vrhovnik_2022,
	abstractnote = {Konformna imerzija iz odprte Riemannove ploskve v Evklidski prostor ${mathbb R}^{n}$, $n geq 3$, je minimalna natanko tedaj, ko je harmoni{\v c}na. Ta osnovni pogoj karakterizira minimalne ploskve, ki so po definiciji stacionarne to{\v c}ke ploskovnega funkcionala. Najpreprostej{\v s}a primera katenoida in helikoid, znana {\v z}e v 18. stoletju, nastaneta kot realni in imaginarni del holomorfne ni{\v c}elne krivulje helikatenoide. Ideja aproksimacije in interpolacije minimalnih ploskev, osrednje teme magistrskega dela, so klasi{\v c}ni izreki za holomorfne funkcije. Periodno dominantni spreji, Morsejeva teorija in teorija konveksne integracije Gromova o obstoju poti s predpisanimi integrali nam omogo{\v c}ajo iskanje bli{\v z}njih preslikav z ni{\v c}elnimi realnimi periodami, ki po Enneper-Weierstrassovi formuli dolo{\v c}ajo minimalne ploskve. Izka{\v z}e se, da izreki tipa Mergelyana, Weierstrassa in Mittag-Lefflerja veljajo za konformne minimalne imerzije ter splo{\v s}nej{\v s}e holomorfne ni{\v c}elne krivulje, pri {\v c}emer v obeh primerih lahko izberemo prave preslikave.},
	author = {Vrhovnik, Tja{\v s}a},
	date-modified = {2025-03-30 22:51:29 +0200},
	title = {Minimalne ploskve : magistrsko delo},
	url = {https://repozitorij.uni-lj.si/IzpisGradiva.php?lang=slv&id=134455},
	year = {2022},
	bdsk-url-1 = {https://repozitorij.uni-lj.si/IzpisGradiva.php?lang=slv&id=134455}}

